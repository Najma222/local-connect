NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional: powers the "Fill with AI" button (server-side only, never prefix with NEXT_PUBLIC)
# Use Google Gemini (free tier) or Anthropic. Setting either one is enough.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
ANTHROPIC_API_KEY=

# Optional: push notifications (Android + iPhone). Generate with: npx web-push generate-vapid-keys
# The public key may be exposed; the private key and secret are server only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Any long random string. Must match the secret in the push_config row (supabase/update-v5-push.sql).
PUSH_WEBHOOK_SECRET=
# Optional contact for push services, e.g. mailto:you@example.com or your site URL
# VAPID_SUBJECT=
